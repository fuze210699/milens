# Milens GitHub App — Environment Variables

# 1. GitHub App ID — from Settings → Developer Settings → GitHub Apps → your app
APP_ID=123456

# 2. Private Key — download .pem file from GitHub App settings, paste entire content
#    Include the BEGIN and END lines, keep line breaks
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
your-key-content-here
-----END RSA PRIVATE KEY-----"

# 3. Webhook Secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=your-generated-secret-here

# 4. Optional: Milens CLI path (if not globally installed)
# MILENS_BIN=npx milens
