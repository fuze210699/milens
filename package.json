{
  "name": "milens",
  "version": "0.7.0",
  "description": "AI-DOS: Code Intelligence Platform — knowledge graphs, security scanning, and closed-loop AI development. 43 MCP tools, 6 sub-agent prompts, 190 security rules, 7 CLI workflows.",
  "type": "module",
  "bin": {
    "milens": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "docs/*.svg",
    "README.md",
    "LICENSE",
    ".agents/skills/",
    "adapters/"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/store/schema.sql','dist/store/schema.sql')\"",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "build:standalone": "node scripts/build-standalone.mjs",
    "build:standalone:all": "node scripts/build-standalone.mjs --target all",
    "self-analyze": "tsx src/cli.ts analyze -p . --force --verbose --skills",
    "self-serve": "tsx src/cli.ts serve -p . --http --port 3100",
    "docs:update": "node scripts/update-docs.js"
  },
  "keywords": [
    "code-intelligence",
    "knowledge-graph",
    "mcp",
    "tree-sitter",
    "static-analysis",
    "codebase-indexer",
    "ai-agent",
    "security-scan",
    "vibe-code",
    "closed-loop",
    "ai-dos",
    "model-context-protocol",
    "sub-agent",
    "code-review",
    "impact-analysis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuze210699/milens.git"
  },
  "homepage": "https://github.com/fuze210699/milens#readme",
  "bugs": {
    "url": "https://github.com/fuze210699/milens/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/fuze210699"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.0.0",
    "commander": "^12.0.0",
    "ignore": "^7.0.0",
    "tree-sitter-wasms": "^0.1.12",
    "web-tree-sitter": "^0.24.7"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@yao-pkg/pkg": "^6.14.2",
    "esbuild": "^0.25.12",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.0"
  }
}
