{
  "repos": [
    {
      "name": "milens",
      "visibility": "Public",
      "license": "MIT",
      "role": "Core engine — parser, analyzer, store, server, security, CLI",
      "isUpstream": true
    },
    {
      "name": "milens-cloud",
      "visibility": "Private",
      "role": "Cloud backend + GitHub App + Stripe"
    },
    {
      "name": "milens-web",
      "visibility": "Private",
      "role": "Landing page + docs (static HTML)"
    }
  ],
  "contract": {
    "package": "@milens/contract",
    "version": "1.0.0"
  },
  "dependencies": [
    {
      "symbol": "analyze()",
      "source": "milens",
      "usedBy": "milens-cloud GitHub App"
    },
    {
      "symbol": "extractFromTree()",
      "source": "milens",
      "usedBy": "milens-cloud GitHub App (via CLI)"
    }
  ]
}
