{
  "version": 2,
  "outputDirectory": "docs",
  "routes": [
    { "src": "/(.*)\\.html$", "dest": "/$1.html", "status": 200 },
    { "handle": "filesystem" },
    { "src": "/([^.]*)$", "dest": "/$1.html", "status": 200 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
