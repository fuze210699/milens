{
  "name": "milens",
  "version": "0.5.4",
  "description": "Lightweight Code Intelligence Platform — analyze codebases and build knowledge graphs",
  "type": "module",
  "bin": {
    "milens": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "docs/*.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/store/schema.sql','dist/store/schema.sql')\"",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "build:standalone": "node scripts/build-standalone.mjs",
    "build:standalone:all": "node scripts/build-standalone.mjs --target all",
    "self-analyze": "tsx src/cli.ts analyze -p . --force --verbose --skills",
    "self-serve": "tsx src/cli.ts serve -p . --http --port 3100"
  },
  "keywords": [
    "code-intelligence",
    "knowledge-graph",
    "mcp",
    "tree-sitter",
    "static-analysis",
    "codebase-indexer",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuze210699/milens.git"
  },
  "homepage": "https://github.com/fuze210699/milens#readme",
  "bugs": {
    "url": "https://github.com/fuze210699/milens/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.0.0",
    "commander": "^12.0.0",
    "ignore": "^7.0.0",
    "tree-sitter-wasms": "^0.1.12",
    "web-tree-sitter": "^0.24.7"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "devDependencies": {
    "@types/better-sqlite3": "^7.0.0",
    "@types/node": "^20.0.0",
    "@yao-pkg/pkg": "^6.14.2",
    "esbuild": "^0.25.12",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.0"
  }
}
